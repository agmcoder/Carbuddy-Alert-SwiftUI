// App Configuration
APP_DISPLAY_NAME = CarBuddy_Alert (Dev)
BUNDLE_ID_SUFFIX = .dev
API_BASE_URL = https://api-dev.myapp.com
LOGGING_ENABLED = YES

// App Icon
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev

// Other Settings
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG DEV_ENVIRONMENT
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 DEV_ENVIRONMENT=1

